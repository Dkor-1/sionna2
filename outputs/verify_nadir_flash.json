  "generator": "benchmark/verify_nadir_flash.py",
  "question_ko": "«앙각 −90°에서 도플러는 0 인데 블레이드 플래시는 남는다» 가 참인가",
  "inputs": {
   "series": "outputs/elevation_sweep_md.npz  (keys ours|sionna|sionna_p250000000 / el±NN)",
