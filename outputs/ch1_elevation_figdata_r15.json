  "generator": "benchmark/build_ch1_elevation_figs.py",
  "purpose_ko": "8/18 Chapter 1 그림이 쓰는 파생량 — 정의를 코드로 못 박고 값을 남긴다",
  "inputs": [
   "outputs/elevation_sweep_md.json",
