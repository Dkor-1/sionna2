<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="s1000plus">
    <!-- 자동 생성: src/gazebo_export.py -->
    <!-- 메쉬: src/drone_cad.py (trimesh + manifold3d + shapely + scipy) -->
    <!-- 제원 출처: docs/drone_specs_2026.json (공식 DJI + 적대적 검증) -->
    <!-- ⚠ 질량 분포/관성텐서는 **메쉬에서 계산한 추정치**다. DJI 는 공개하지 않는다. -->
    <!--   총질량만 공식 TOW(9500 g)에 맞췄고, 분포는 부위별 밀도가 정했다. -->

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>9.385785</mass>
        <pose>0.000914 -0.000000 -0.001117 0 0 0</pose>
        <inertia>
          <ixx>0.41337642</ixx> <ixy>-0.00000000</ixy> <ixz>0.00071413</ixz>
          <iyy>0.41456010</iyy> <iyz>0.00000000</iyz> <izz>0.77221232</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><mesh><uri>model://s1000plus/meshes/base_link_collision.stl</uri></mesh></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><mesh><uri>model://s1000plus/meshes/base_link.stl</uri></mesh></geometry>
      </visual>
    </link>

    <link name="rotor_0">
      <pose>0.482037 0.199666 0.063798 0 0 0.602139</pose>
      <inertial>
        <mass>0.014277</mass>
        <inertia>
          <ixx>0.0000012436</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0000145918</iyy> <iyz>0</iyz> <izz>0.0000151754</izz>
