<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="phantom4">
    <!-- 자동 생성: src/gazebo_export.py -->
    <!-- 메쉬: src/drone_cad.py (trimesh + manifold3d + shapely + scipy) -->
    <!-- 제원 출처: docs/drone_specs_2026.json (공식 DJI + 적대적 검증) -->
    <!-- ⚠ 질량 분포/관성텐서는 **메쉬에서 계산한 추정치**다. DJI 는 공개하지 않는다. -->
    <!--   총질량만 공식 TOW(1380 g)에 맞췄고, 분포는 부위별 밀도가 정했다. -->

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.376898</mass>
        <pose>-0.001732 -0.000000 -0.003018 0 0 0</pose>
        <inertia>
          <ixx>0.00562556</ixx> <ixy>0.00000002</ixy> <ixz>0.00059810</ixz>
          <iyy>0.00574443</iyy> <iyz>-0.00000005</iyz> <izz>0.00826705</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><mesh><uri>model://phantom4/meshes/base_link_collision.stl</uri></mesh></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><mesh><uri>model://phantom4/meshes/base_link.stl</uri></mesh></geometry>
      </visual>
    </link>

    <link name="rotor_0">
      <pose>0.126190 0.126190 0.037550 0 0 0.994838</pose>
      <inertial>
        <mass>0.000776</mass>
        <inertia>
          <ixx>0.0000000246</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0000001451</iyy> <iyz>0</iyz> <izz>0.0000001562</izz>
        </inertia>
      </inertial>
      <collision name="rotor_collision">
        <geometry><mesh><uri>model://phantom4/meshes/rotor_collision.stl</uri></mesh></geometry>
      </collision>
      <visual name="rotor_visual">
        <geometry><mesh><uri>model://phantom4/meshes/rotor.stl</uri></mesh></geometry>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>890.12</maxRotVelocity>
      <motorConstant>1.019899e-05</motorConstant>
      <momentConstant>0.0144</momentConstant>
      <rotorDragCoefficient>8.064280e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorNumber>0</motorNumber>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
    </plugin>

    <link name="rotor_1">
      <pose>-0.126190 0.126190 0.037550 0 0 2.565634</pose>
      <inertial>
        <mass>0.000776</mass>
        <inertia>
          <ixx>0.0000000246</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0000001451</iyy> <iyz>0</iyz> <izz>0.0000001562</izz>
        </inertia>
      </inertial>
      <collision name="rotor_collision">
        <geometry><mesh><uri>model://phantom4/meshes/rotor_collision.stl</uri></mesh></geometry>
      </collision>
      <visual name="rotor_visual">
        <geometry><mesh><uri>model://phantom4/meshes/rotor.stl</uri></mesh></geometry>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>890.12</maxRotVelocity>
      <motorConstant>1.019899e-05</motorConstant>
      <momentConstant>0.0144</momentConstant>
      <rotorDragCoefficient>8.064280e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorNumber>1</motorNumber>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
    </plugin>

    <link name="rotor_2">
      <pose>-0.126190 -0.126190 0.037550 0 0 4.136430</pose>
      <inertial>
        <mass>0.000776</mass>
        <inertia>
          <ixx>0.0000000246</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0000001451</iyy> <iyz>0</iyz> <izz>0.0000001562</izz>
        </inertia>
      </inertial>
      <collision name="rotor_collision">
        <geometry><mesh><uri>model://phantom4/meshes/rotor_collision.stl</uri></mesh></geometry>
      </collision>
      <visual name="rotor_visual">
        <geometry><mesh><uri>model://phantom4/meshes/rotor.stl</uri></mesh></geometry>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>890.12</maxRotVelocity>
      <motorConstant>1.019899e-05</motorConstant>
      <momentConstant>0.0144</momentConstant>
      <rotorDragCoefficient>8.064280e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
