    <link name="rotor_3">
      <pose>0.126190 -0.126190 0.037550 0 0 5.707227</pose>
      <inertial>
        <mass>0.000776</mass>
        <inertia>
          <ixx>0.0000000246</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0000001451</iyy> <iyz>0</iyz> <izz>0.0000001562</izz>
        </inertia>
      </inertial>
      <collision name="rotor_collision">
        <geometry><mesh><uri>model://phantom4/meshes/rotor_collision.stl</uri></mesh></geometry>
      </collision>
      <visual name="rotor_visual">
