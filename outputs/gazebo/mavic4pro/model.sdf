      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorNumber>1</motorNumber>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
    </plugin>

    <link name="rotor_2">
      <pose>-0.146397 -0.163218 0.066644 0 0 3.909538</pose>
      <inertial>
        <mass>0.000683</mass>
        <inertia>
          <ixx>0.0000000272</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0000001885</iyy> <iyz>0</iyz> <izz>0.0000002008</izz>
        </inertia>
      </inertial>
      <collision name="rotor_collision">
