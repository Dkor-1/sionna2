<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="mini5pro">
    <!-- 자동 생성: src/gazebo_export.py -->
    <!-- 메쉬: src/drone_cad.py (trimesh + manifold3d + shapely + scipy) -->
    <!-- 제원 출처: docs/drone_specs_2026.json (공식 DJI + 적대적 검증) -->
    <!-- ⚠ 질량 분포/관성텐서는 **메쉬에서 계산한 추정치**다. DJI 는 공개하지 않는다. -->
    <!--   총질량만 공식 TOW(250 g)에 맞췄고, 분포는 부위별 밀도가 정했다. -->

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.249408</mass>
        <pose>0.008358 -0.000000 0.002465 0 0 0</pose>
        <inertia>
          <ixx>0.00074593</ixx> <ixy>0.00000000</ixy> <ixz>0.00006329</ixz>
          <iyy>0.00073099</iyy> <iyz>-0.00000000</iyz> <izz>0.00131302</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><mesh><uri>model://mini5pro/meshes/base_link_collision.stl</uri></mesh></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><mesh><uri>model://mini5pro/meshes/base_link.stl</uri></mesh></geometry>
      </visual>
    </link>

    <link name="rotor_0">
      <pose>0.076291 0.114394 0.022107 0 0 1.192060</pose>
      <inertial>
        <mass>0.000123</mass>
        <inertia>
          <ixx>0.0000000015</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0000000069</iyy> <iyz>0</iyz> <izz>0.0000000075</izz>
        </inertia>
      </inertial>
      <collision name="rotor_collision">
        <geometry><mesh><uri>model://mini5pro/meshes/rotor_collision.stl</uri></mesh></geometry>
      </collision>
      <visual name="rotor_visual">
        <geometry><mesh><uri>model://mini5pro/meshes/rotor.stl</uri></mesh></geometry>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>816.81</maxRotVelocity>
      <motorConstant>1.846904e-06</motorConstant>
      <momentConstant>0.0100</momentConstant>
      <rotorDragCoefficient>8.064280e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorNumber>0</motorNumber>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>velocity</motorType>
    </plugin>

    <link name="rotor_1">
      <pose>-0.076291 0.114394 0.046744 0 0 2.368412</pose>
      <inertial>
        <mass>0.000123</mass>
        <inertia>
          <ixx>0.0000000015</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0000000069</iyy> <iyz>0</iyz> <izz>0.0000000075</izz>
        </inertia>
