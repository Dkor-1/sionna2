 "snr_convention": {
  "name": "v2_2026-08",
  "canonical_rung": "snr_slow_ac_db",
  "rungs": [
   {
    "id": "snr_band_db",
    "formula": "P_echo/(k*T0*F*B)",
    "level": "pre-matched-filter, per Rx sample"
   },
   {
    "id": "g_mf_db",
    "formula": "10*log10(B/PRF)",
    "condition": "capture=full_waveform",
    "value_example_db": 37.06
   },
   {
    "id": "snr_slow_db",
    "formula": "snr_band_db + g_mf_db",
    "level": "per slow-time sample, TOTAL power"
   },
   {
    "id": "dc_ac_off_db",
    "formula": "10*log10(1+10**(dc_ac_db/10))",
    "note": "현행 ac_snr_db()는 dc_ac_db를 그냥 뺀다(>=10dB에서 오차<=0.41dB, 0dB에서 3.0dB)"
   },
   {
    "id": "snr_slow_ac_db",
    "formula": "snr_slow_db - dc_ac_off_db",
    "canonical": true
   },
   {
    "id": "g_stft_db",
    "formula": "10*log10(N_seg) + L_win",
    "value_example_db": 16.69,
    "caveat": "STFT 조각에 적용하는 것은 우리 유추. Braun eq 3.37은 2D 페리오도그램(NM) 것 [조사]"
   },
   {
    "id": "snr_map_ac_db",
    "formula": "snr_slow_ac_db + g_stft_db"
   }
  ],
  "constants": {
   "T0_K": 290.0,
   "nf_db": 5.0,
   "b_hz": 100000000.0,
   "prf_hz": 19700.0,
   "nperseg": 70,
   "window_coh_loss_db": {
    "hann": -1.76,
    "hamming": -1.35,
    "boxcar": 0.0
   },
   "window_loss_source": "Braun PhD KIT 2014 eq(3.77), Table 3.3 [조사]"
  },
  "do_not_confuse": {
   "cpi_coherent_gain_2s_db": 45.95,
   "stft_frame_gain_db": 16.69,
   "note": "CPI 전체 코히어런트 이득과 STFT 한 조각 이득은 다른 수다 [조사 §3.1]"
  }
 },
